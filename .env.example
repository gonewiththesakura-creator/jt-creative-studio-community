# REVIEW TEMPLATE ONLY. Never commit the real .env file.
# Generate a new access token: python -c "import secrets; print(secrets.token_urlsafe(36))"
JT_ACCESS_TOKEN=REPLACE_WITH_A_NEW_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS

# All three provider settings must be configured together, or all left empty.
# Use YOUR provider's documented HTTPS /v1/images/generations endpoint and model.
# Example host is reserved and intentionally does not work. No supplier is endorsed.
JT_IMAGE_ENDPOINT=
JT_IMAGE_API_KEY=
JT_IMAGE_MODEL=
# Example format only: https://images.example.invalid/v1/images/generations
JT_PROVIDER_TIMEOUT=180

# Native Python defaults. Docker Compose overrides bind/data settings internally.
JT_BIND=127.0.0.1
JT_PORT=8189
JT_DATA_DIR=./data
# For Docker local mode set http://127.0.0.1:8189.
# For remote mode use your exact HTTPS origin, with no path or trailing slash.
JT_PUBLIC_URL=http://127.0.0.1:8189
